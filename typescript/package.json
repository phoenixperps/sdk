{
  "name": "@phoenixperps/sdk",
  "version": "1.1.0",
  "description": "The Phoenix Perpetuals API: REST, the account stream and market data, with retries, idempotency and typed errors.",
  "license": "MIT",
  "homepage": "https://docs.phoenixperpsfunding.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phoenixperps/sdk.git",
    "directory": "typescript"
  },
  "main": "src/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./src/index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./src/index.js"
      }
    }
  },
  "files": [
    "src",
    "index.d.ts",
    "index.d.mts",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ws": "8.18.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "typecheck": "tsc -p test/tsconfig.json && tsc -p examples/tsconfig.json"
  },
  "keywords": [
    "phoenix perpetuals",
    "perpetuals",
    "trading",
    "api",
    "sdk"
  ],
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3"
  }
}
